# Server only. Never prefix these with VITE_ (VITE_ variables are shipped to the browser).
# Claude (Anthropic): understands free-form sentences ("I am near the lift lobby and I want to go to the pantry") and reads camera pictures.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5            # looks at the camera picture
# ANTHROPIC_FAST_MODEL=claude-haiku-4-5-20251001   # reads the sentence
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
