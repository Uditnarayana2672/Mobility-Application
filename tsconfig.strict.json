{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "./node_modules/.tmp/strict-types",
    "tsBuildInfoFile": "./node_modules/.tmp/strict.tsbuildinfo",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["node", "vite/client"],
    "baseUrl": ".",
    "paths": { "@/*": ["./src/*"] }
  },
  "include": [
    "src/core",
    "src/bus",
    "src/navigator",
    "src/dashboard",
    "src/shared",
    "src/ui",
    "src/editor",
    "src/markers",
    "src/owner",
    "src/spikes",
    "server",
    "tests",
    "scripts/convert-mock-venue.ts",
    "vite.config.ts",
    "vitest.config.ts"
  ]
}
